<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/margin_padding_size_large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:id="@+id/shortcutNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/auto_start"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/shortcutAutostartCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shortcutStartHiddenContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Start hidden (long press Volume Up button to show)"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/shortcutStartHiddenCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shortcutCloseAfterFinishContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Close app after finish"
            android:layout_weight="1"/>
        <CheckBox
            android:id="@+id/shortcutCloseAfterFinishCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
