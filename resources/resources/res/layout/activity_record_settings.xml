<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activitySettingsParentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:paddingLeft="@dimen/margin_padding_size_large"
        android:paddingTop="@dimen/margin_padding_size_large"
        android:paddingRight="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_padding_size_large">
        <TextView
            android:textSize="24sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_mode_settings"
            android:layout_weight="1"
            fontPath="fonts/jakarta_bold.ttf"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/recordSettingsMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more"/>
    </LinearLayout>
    <View
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/margin_padding_size_large"
        android:layout_marginTop="@dimen/margin_padding_size_small"
        android:layout_marginRight="@dimen/margin_padding_size_large"
        android:layout_marginBottom="@dimen/margin_padding_size_small"
        android:alpha="0.1"
        android:layout_marginHorizontal="@dimen/margin_padding_size_large"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/margin_padding_size_large"
            android:paddingRight="@dimen/margin_padding_size_large"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/margin_padding_size_large">
            <TextView
                android:textSize="20sp"
                android:id="@+id/recordSettingsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unsaved"
                fontPath="fonts/jakarta_bold.ttf"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/recordSettingsDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unsaved"
                android:alpha="0.5"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <Button
                android:id="@+id/recordSettingsEditButton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/recordSettingsSaveCurrentButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/recordSettingsSaveAsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_as"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/recordSettingsLoadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/load_export_manage"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/recordSettingsExportButton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export"
                style="@style/SettingsButton"/>
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/text_size_large"
                android:text="@string/settings"
                fontPath="fonts/jakarta_bold.ttf"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <FrameLayout
                android:id="@+id/recordModePlaybackAppSettings"
                android:background="@drawable/floating_background"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_performance"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/recordSettingsRepeatCountContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_count"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/recordSettingsRepeatCountValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/recordSettingsPauseTimeContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pause_before_repeat"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/recordSettingsPauseTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/recordSettingsPlaybackSpeedContainer"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_speed"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/recordSettingsPlaybackSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1x"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</LinearLayout>
