<?xml version="1.0" encoding="utf-8"?>
<com.inscode.autoclicker.utils.DuoDrawerLayout2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:clickToCloseScale="1"
    app:contentScaleClosed="1"
    app:contentScaleOpen="0.7">
    <nl.psdcompany.duonavigationdrawer.views.DuoMenuView
        android:orientation="vertical"
        android:tag="@string/tag_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7">
                <FrameLayout
                    android:padding="@dimen/margin_padding_size_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/menuBackButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_back"/>
                </FrameLayout>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:padding="@dimen/margin_padding_size_mediumx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/buttonSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings"
                            style="@style/ModeTextStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:padding="@dimen/margin_padding_size_mediumx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/buttonTutorial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorial"
                            style="@style/ModeTextStyle"/>
                    </FrameLayout>
                    <FrameLayout
                        android:padding="@dimen/margin_padding_size_mediumx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/buttonRestartApp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/restart_app"
                            style="@style/ModeTextStyle"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="#22000000"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3"/>
        </LinearLayout>
    </nl.psdcompany.duonavigationdrawer.views.DuoMenuView>
    <LinearLayout
        android:orientation="vertical"
        android:tag="@string/tag_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:orientation="horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="20dp"
            android:paddingRight="24dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">
            <ImageView
                android:id="@+id/navButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_navigation"/>
            <TextView
                android:textSize="20sp"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                fontPath="fonts/jakarta_bold.ttf"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingLeft="24dp"
                    android:paddingTop="@dimen/margin_padding_size_xxlarge"
                    android:paddingRight="@dimen/margin_padding_size_xxlarge"
                    android:paddingBottom="@dimen/margin_padding_size_large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/state"
                        style="@style/ModeTextStyle"/>
                    <Switch
                        android:id="@+id/stateSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/pendingContent"
                    android:background="@drawable/gray_background"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_size_small">
                    <TextView
                        android:textColor="#ff000000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_processed"
                        fontPath="fonts/jakarta_bold.ttf"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/buyContent"
                    android:background="@drawable/accent_background"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_size_small">
                    <TextView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_pro"
                        fontPath="fonts/jakarta_bold.ttf"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/proContent"
                    android:background="@drawable/pro_background"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/text_size_small"
                    android:layout_marginRight="@dimen/text_size_small">
                    <TextView
                        android:textColor="#ff000000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/fullVersionText"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You are PRO user."
                        fontPath="fonts/jakarta_bold.ttf"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/betaFeedback"
                    android:background="@drawable/selected_background"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_size_small">
                    <TextView
                        android:textColor="#ffffffff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:padding="@dimen/text_size_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Do you want to send us feedback or check BETA changelog? Tap here."
                        fontPath="fonts/jakarta_bold.ttf"/>
                </FrameLayout>
                <TextView
                    android:textColor="@color/textHeadline"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_padding_size_large"
                    android:text="App modes"
                    android:textAllCaps="true"
                    style="@style/SettingsHeadlineTextStyle"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mainModeList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/manualSettingsWarningContainer"
                    android:background="@drawable/floating_background"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/text_size_small">
                    <TextView
                        android:gravity="center"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tip: If your screen is unresponsive after starting clicker, press power button to turn screen off and wait 2 seconds to emergency stop."/>
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.zipoapps.ads.PhShimmerBannerAdView
            android:layout_gravity="bottom"
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:banner_size="adaptive_anchored"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shimmer_base_color="#ffffffff"
            app:shimmer_highlight_color="#ffb3b3b3"/>
    </LinearLayout>
</com.inscode.autoclicker.utils.DuoDrawerLayout2>
