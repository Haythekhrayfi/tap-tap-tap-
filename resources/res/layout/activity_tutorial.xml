<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorialViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bottomControls"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/banner_container">
        <ImageView
            android:id="@+id/tutorialArrowLeft"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/tutorialSkipButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/exit"
            android:layout_weight="1"
            style="@style/TextStyleBold"/>
        <ImageView
            android:id="@+id/tutorialArrowRight"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
