<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/itemModeContainer"
    android:background="@drawable/selected_background"
    android:paddingLeft="20dp"
    android:paddingTop="@dimen/margin_padding_size_small"
    android:paddingRight="20dp"
    android:paddingBottom="@dimen/margin_padding_size_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/margin_padding_size_medium"
    android:layout_marginTop="@dimen/margin_padding_size_small"
    android:layout_marginRight="@dimen/margin_padding_size_medium">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/itemModeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ph_admob_app_id"
            style="@style/ModeTextStyle"/>
        <TextView
            android:id="@+id/itemModeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single target mode"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/itemModeDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/circle_white"/>
    </FrameLayout>
</LinearLayout>
