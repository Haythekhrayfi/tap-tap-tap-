<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingLeft="@dimen/margin_padding_size_large"
        android:paddingRight="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_size_medium"
        android:layout_marginBottom="@dimen/margin_padding_size_medium">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"/>
        <TextView
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            fontPath="fonts/jakarta_bold.ttf"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/margin_padding_size_large"
            android:paddingRight="@dimen/margin_padding_size_large"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/text_size_large"
                android:text="@string/experimental"
                fontPath="fonts/jakarta_bold.ttf"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsPlaybackEngineContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_engine"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/settingsPlaybackEngineValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/one_to_one"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/improve_swipe"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/experimentalSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/improve_swipe_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsBackgroundService"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/avoid_killing"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsBackgroundServiceSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/avoid_killing_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/text_size_large"
                android:text="@string/user_interface"
                fontPath="fonts/jakarta_bold.ttf"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsLayoutOrientationContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_orientation"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/settingsLayoutOrientationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/horizontal"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsLayoutSizeContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_size"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/settingsLayoutSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/normal"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsTurnOffWhenScreenOff"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/turn_off_screen_off"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsTurnOffWhenScreenOffSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/turn_off_screen_off_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsPlaySoundWhenFinished"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/notify_completion"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsNotifyWhenFinishedSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_completion_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsLayoutCombineLabelContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/display_recording_label"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsLayoutCombineLabelSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/display_recording_label_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsLayoutTimeLeftContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/display_time_left"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsLayoutTimeLeftSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/display_time_left_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsOpenModeSettings"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/open_settings_mode_select"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsOpenModeSettingsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_settings_mode_select_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsVolumeUpToHide"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/long_press"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsVolumeUpSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/long_press_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsRecordingPopupSettings"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/recordings_confirm"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsRecordingPopupSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recordings_confirm_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settingsMainThread"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_size_large"
                    android:text="@string/performance"
                    fontPath="fonts/jakarta_bold.ttf"/>
                <View
                    android:background="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:layout_marginBottom="@dimen/margin_padding_size_small"
                    android:alpha="0.1"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/main_thread"
                        android:lines="1"
                        android:scrollHorizontally="true"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <Switch
                        android:id="@+id/settingsMainThreadSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_thread_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/text_size_large"
                android:text="@string/others"
                fontPath="fonts/jakarta_bold.ttf"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/moreSettingsContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/other_settings"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/other_settings_desc"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</LinearLayout>
