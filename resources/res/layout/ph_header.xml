<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/crown_image"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_ph_crown"
        app:tint="?attr/premium_offer_header_logo_color"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/premium_offer_primary_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/title_text"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ph_start_like_pro"
        android:lineSpacingExtra="4sp"
        android:textAllCaps="true"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/crown_image"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/premium_offer_secondary_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/subtitle_text"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ph_unlock_all_features"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@+id/title_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
