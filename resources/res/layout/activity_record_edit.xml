<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="24sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record editing"
            fontPath="fonts/jakarta_bold.ttf"/>
        <View
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:layout_marginBottom="@dimen/margin_padding_size_small"
            android:alpha="0.1"/>
        <TextView
            android:textSize="20sp"
            android:id="@+id/recordEditName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unsaved"
            fontPath="fonts/jakarta_bold.ttf"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/recordEditDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unsaved"
            android:alpha="0.5"/>
        <View
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:layout_marginBottom="@dimen/margin_padding_size_small"
            android:alpha="0.1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recordEditList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</LinearLayout>
