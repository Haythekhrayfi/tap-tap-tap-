<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/combineParentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/margin_padding_size_large"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/buttonBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_back"/>
                    <TextView
                        android:textSize="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margin_padding_size_large"
                        android:text="@string/combination"
                        android:layout_weight="1"
                        fontPath="fonts/jakarta_bold.ttf"/>
                    <ImageView
                        android:id="@+id/buttonConfirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_check"/>
                </LinearLayout>
                <View
                    android:background="#ffffffff"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:layout_marginBottom="@dimen/margin_padding_size_small"
                    android:alpha="0.1"/>
                <Button
                    android:id="@+id/loadSettingsImport"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_recordings"
                    style="@style/SettingsButton"/>
                <View
                    android:background="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:layout_marginBottom="@dimen/margin_padding_size_small"
                    android:alpha="0.1"/>
                <TextView
                    android:textSize="20sp"
                    android:id="@+id/combinationEditName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unsaved"
                    fontPath="fonts/jakarta_bold.ttf"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/combinationEditDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unsaved"
                    android:alpha="0.5"/>
                <TextView
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_size_large"
                    android:text="@string/settings"
                    fontPath="fonts/jakarta_bold.ttf"/>
                <View
                    android:background="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:layout_marginBottom="@dimen/margin_padding_size_small"
                    android:alpha="0.1"/>
                <FrameLayout
                    android:id="@+id/combinePlaybackAppSettings"
                    android:background="@drawable/floating_background"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:gravity="center"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/combination_tip"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/combineSettingsRepeatCountContainer"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_size_medium">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/repeat_count"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <TextView
                        android:id="@+id/combineSettingsRepeatCountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        style="@style/SettingsDescriptionTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/combineSettingsPauseTimeContainer"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_size_medium">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pause_before_repeat"
                        android:layout_weight="1"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <TextView
                        android:id="@+id/combineSettingsPauseTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        style="@style/SettingsDescriptionTextStyle"/>
                </LinearLayout>
                <TextView
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_size_xlarge"
                    android:text="@string/added_recordings"
                    fontPath="fonts/jakarta_bold.ttf"/>
                <View
                    android:background="#ffffffff"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:layout_marginBottom="@dimen/margin_padding_size_small"
                    android:alpha="0.1"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recordingsList"
                    android:paddingBottom="56dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <TextView
                    android:id="@+id/noRecordings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/combination_no_recordings"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addFabButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_fab_add"
        app:layout_constraintBottom_toTopOf="@+id/banner_container"
        app:layout_constraintEnd_toEndOf="@+id/banner_container"/>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
