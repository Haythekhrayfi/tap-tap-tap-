<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activitySettingsParentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:paddingLeft="@dimen/margin_padding_size_large"
        android:paddingRight="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_padding_size_medium"
            android:layout_marginBottom="@dimen/margin_padding_size_large">
            <TextView
                android:textSize="20sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accessibility_service_consent"
                fontPath="fonts/jakarta_bold.ttf"/>
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_description"/>
        <View
            android:layout_width="0dp"
            android:layout_height="16dp"/>
        <TextView
            android:textColor="@color/green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_review"/>
        <View
            android:layout_width="0dp"
            android:layout_height="16dp"/>
        <TextView
            android:textColor="@color/green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_features"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_features_list"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <TextView
            android:textColor="@color/green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accessibility_data"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_described"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/with_usage"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="24dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/consentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/consentCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="6dp"
                android:layout_height="0dp"/>
            <TextView
                android:textColor="@color/green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_accept"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="16dp"/>
        <Button
            android:enabled="false"
            android:textColor="@color/gnt_black"
            android:gravity="center"
            android:id="@+id/consentCancelButton"
            android:background="@drawable/cancel_button"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel"/>
        <View
            android:layout_width="16dp"
            android:layout_height="0dp"/>
        <Button
            android:enabled="false"
            android:textColor="@color/gnt_black"
            android:gravity="center"
            android:id="@+id/consentProceedButton"
            android:background="@drawable/ad_button"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_continue"/>
        <View
            android:layout_width="0dp"
            android:layout_height="16dp"/>
    </LinearLayout>
</ScrollView>
