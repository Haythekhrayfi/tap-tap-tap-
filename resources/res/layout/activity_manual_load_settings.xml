<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/loadParentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_padding_size_medium">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"/>
            <TextView
                android:textSize="20sp"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/load_settings"
                fontPath="fonts/jakarta_bold.ttf"/>
        </FrameLayout>
        <View
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:layout_marginBottom="@dimen/margin_padding_size_small"
            android:alpha="0.1"/>
        <Button
            android:id="@+id/loadSettingsImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_settings"
            style="@style/SettingsButton"/>
        <View
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:layout_marginBottom="@dimen/margin_padding_size_small"
            android:alpha="0.1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:background="@drawable/search_background"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:textSize="12sp"
                    android:id="@+id/searchField"
                    android:background="@null"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Search..."
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="textNoSuggestions"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/resetSearchQueryButton"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_close"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sortingByButton"
                android:paddingLeft="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sorting"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sortingOrderButton"
                android:paddingLeft="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sorting_order"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/loadSettingsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</LinearLayout>
