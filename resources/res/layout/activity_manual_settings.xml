<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/margin_padding_size_large"
        android:paddingRight="@dimen/margin_padding_size_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_padding_size_large"
        android:paddingHorizontal="@dimen/margin_padding_size_large">
        <TextView
            android:textSize="24sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_mode_settings"
            android:layout_weight="1"
            fontPath="fonts/jakarta_bold.ttf"/>
        <ImageView
            android:id="@+id/manualSettingsMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more"/>
    </LinearLayout>
    <View
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/margin_padding_size_large"
        android:layout_marginTop="@dimen/margin_padding_size_medium"
        android:layout_marginRight="@dimen/margin_padding_size_large"
        android:layout_marginBottom="@dimen/margin_padding_size_medium"
        android:alpha="0.1"
        android:layout_marginHorizontal="@dimen/margin_padding_size_large"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/margin_padding_size_large"
            android:paddingRight="@dimen/margin_padding_size_large"
            android:paddingBottom="@dimen/margin_padding_size_large"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/margin_padding_size_large">
            <TextView
                android:textSize="20sp"
                android:id="@+id/manualSettingsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unsaved"
                fontPath="fonts/jakarta_bold.ttf"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/manualSettingsDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unsaved"
                android:alpha="0.5"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <Button
                android:id="@+id/manualSettingsSaveCurrentButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/manualSettingsSaveAsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_as"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/manualSettingsLoadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/load_export_manage"
                style="@style/SettingsButton"/>
            <Button
                android:id="@+id/manualSettingsExportButton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export"
                style="@style/SettingsButton"/>
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/text_size_large"
                android:text="@string/settings"
                fontPath="fonts/jakarta_bold.ttf"/>
            <View
                android:background="#ffffffff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:layout_marginBottom="@dimen/margin_padding_size_small"
                android:alpha="0.1"/>
            <FrameLayout
                android:id="@+id/manualSettingsWarningContainer"
                android:background="@drawable/red_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:id="@+id/manualSettingsWarningText"
                    android:padding="@dimen/margin_padding_size_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/manualSettingsWarningUnresponsiveContainer"
                android:background="@drawable/red_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_padding_size_large">
                <TextView
                    android:gravity="center"
                    android:id="@+id/manualSettingsWarningUnresponsiveText"
                    android:padding="@dimen/margin_padding_size_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/one_finger_mode_title"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <TextView
                        android:id="@+id/manualSettingsOneFingerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/one_finger_mode_desc"
                        style="@style/SettingsDescriptionTextStyle"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/manualSettingsOneFingerSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manualSettingsTimeBetweenContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_interval"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/manualSettingsTimeBetweenSetsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300 [ms]"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manualSettingsClickDurationContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/click_duration"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/manualSettingsClickDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200 [ms]"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manualSettingsSwipeDurationContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swipe_duration"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/manualSettingsSwipeDurationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200 [ms]"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/manualSettingsRepeatCountContainer"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_count"
                    style="@style/SettingsHeadlineTextStyle"/>
                <TextView
                    android:id="@+id/manualSettingsRepeatCountValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/infinity"
                    style="@style/SettingsDescriptionTextStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_medium">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/random_actions"
                        style="@style/SettingsHeadlineTextStyle"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/random_actions_desc"
                        style="@style/SettingsDescriptionTextStyle"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/manualSettingsRandomizeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.zipoapps.ads.PhShimmerBannerAdView
        android:layout_gravity="bottom"
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:banner_size="adaptive_anchored"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_base_color="#ffffffff"
        app:shimmer_highlight_color="#ffb3b3b3"/>
</LinearLayout>
